# Podman quadlet: copy to ~/.config/containers/systemd/ (or /etc/containers/systemd/) and
# `systemctl --user daemon-reload && systemctl --user start ntfy-idp-push`.
[Unit]
Description=ntfy-idp-push (Duo Auth API over ntfy)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/babraham123/ntfy-idp-push:latest
ContainerName=ntfy-idp-push
PublishPort=443:8443
Volume=ntfy-idp-push.volume:/var/lib/ntfy-idp-push
Volume=%h/.config/ntfy-idp-push/server.yml:/etc/ntfy-idp-push/server.yml:ro,Z
# Secrets via env keep them out of the config file, e.g.:
# Secret=ntfy-idp-push-skey,type=env,target=NTFY_IDP_PUSH_DUO_SECRET_KEY
HealthCmd=/usr/bin/ntfy-idp-push healthcheck
HealthInterval=30s
ReloadSignal=SIGHUP

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
