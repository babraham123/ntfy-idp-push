{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "A pin locks the version already in use, so there is no new release to wait out",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Digest updates and lock file refreshes carry no release timestamp, so a release-age wait would hold them pending forever",
      "matchUpdateTypes": ["digest", "lockFileMaintenance"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "container base images"
    },
    {
      "description": "The compose file follows this repo's own image; a digest pin would go stale with every release",
      "matchPackageNames": ["ghcr.io/babraham123/ntfy-idp-push"],
      "enabled": false
    }
  ]
}
